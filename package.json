    "check:v299": "node scripts/check-v299-upgrade.mjs",
    "check:v2910": "node scripts/check-v2910-upgrade.mjs",
    "check:v2911": "node scripts/check-v2911-upgrade.mjs",
    "check:admin-session": "node scripts/check-admin-session.mjs",
    "check:v2912": "node scripts/check-v2912-security.mjs",
    "check:v2913": "node scripts/check-v2913.mjs",
    "check:v2913-production": "node scripts/check-v2913-production.mjs",
    "check:v2914": "node scripts/check-v2914.mjs",
    "check:v2915": "node scripts/check-v2915.mjs",
    "check:v2915-modes": "node scripts/check-v2915-modes.mjs",
    "check:firebase-guard": "node --test firebase-guard/functions/test/guard.test.js",
    "check:v2916": "node scripts/check-v2916.mjs"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "dotenv": "^16.6.1"
  },
  "author": "DevKunn Learn <devkun22@gmail.com>"
}
