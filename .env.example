# DevKunn Learn V2.5 - Sao chép thành .env.local rồi điền thông tin Supabase.
# VITE_* được Vite đưa vào trình duyệt khi BUILD: KHÔNG ĐƯỢC ĐẶT SECRET KEY.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# true = hiện tính năng; false = ẩn. Sau khi thay đổi cần build/deploy lại.
VITE_FEATURE_HW_PRACTICE=true
VITE_FEATURE_HW_RANDOM=true
VITE_FEATURE_HW_FLAG=true
VITE_FEATURE_HW_NOTES=true
VITE_FEATURE_HW_PROGRESS=true
VITE_FEATURE_SLIDE_LEARNING=true
VITE_FEATURE_EXAM=true
VITE_FEATURE_EXAM_HISTORY=true
VITE_FEATURE_ANONYMOUS_LOGIN=true
VITE_FEATURE_EMAIL_LOGIN=true
# Những phần chưa triển khai được TẮT mặc định.
VITE_FEATURE_AI_GENERATOR=false
VITE_FEATURE_DOCUMENT_UPLOAD=false
VITE_FEATURE_ESSAY_PRACTICE=false

# Chỉ dành cho Vercel Server Functions (KHÔNG thêm VITE_)
# Nhập các biến này qua Vercel Environment Variables, không commit giá trị thật.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVER_KEY
# AI_SETTINGS_ENCRYPTION_KEY=YOUR_RANDOM_32_BYTE_BASE64_KEY
# AI_PROVIDER_MODEL=gpt-4.1-mini
# AI_PROVIDER_API_KEY=OPTIONAL_FALLBACK_SERVER_KEY

# ------------------------------------------------------------
# Firebase AI Logic (Web) - đã có nút chẩn đoán kết nối thật ở /admin.
# Lấy Firebase Web App config tại Firebase Console > Project settings > Your apps.
# VITE_* là cấu hình công khai được đưa vào bundle browser, KHÔNG nhập secret key.
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=webapp-trangchiem
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
# Nếu Firebase Web Config có các trường sau, hãy điền tương ứng:
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET

# Lấy site key/Key ID ở Google Cloud Fraud Defense (reCAPTCHA Enterprise).
# Đây là SITE KEY cho browser, KHÔNG PHẢI secret key và KHÔNG PHẢI Gemini API key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY

# Tùy chọn: model Gemini cho Firebase AI Logic sau khi tích hợp và xác minh.
# Không đoán tên model; phiên bản tích hợp phải kiểm tra model có hỗ trợ.
VITE_FIREBASE_GEMINI_MODEL=gemini-3.5-flash-lite

# App Check Debug Token dành riêng localhost: đăng ký tại Firebase Console > App Check.
# KHÔNG lưu debug token vào VITE_*, .env.example, mã nguồn hoặc bản production.
# ------------------------------------------------------------

# Firebase AI Tutor dành cho người học — MẶC ĐỊNH TẮT
# Chỉ bật sau khi đã triển khai Firebase Cloud Function bảo vệ quota và nghiệm thu.
VITE_FIREBASE_LEARNER_GUARDED=false
# Server Vercel: phải dùng cùng secret ngẫu nhiên với Firebase Functions Secret Manager.
# AI_FIREBASE_GATE_SECRET=<random secret >= 32 bytes>
# AI_FIREBASE_GUARD_DEPLOYED=false
